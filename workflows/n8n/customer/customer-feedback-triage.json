{
  "name": "Customer feedback triage: classify, log, route bugs and churn risk",
  "nodes": [
    {
      "parameters": {
        "content": "## Feedback triage (original)\nPOST feedback from any source (in-app widget, Typeform/Tally webhook, support inbox forwarder). An LLM labels type, severity and product area, everything is logged, bugs go to the bugs channel, churn risks go to the customer channel with a **Gmail draft** reply ready for a human.",
        "height": 240,
        "width": 500
      },
      "id": "8b5012e9-7d9d-594c-95c2-f32b9a250cf4",
      "name": "Note 1",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -240,
        -400
      ]
    },
