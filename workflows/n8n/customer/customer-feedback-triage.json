      "typeVersion": 3.4,
      "position": [
        240,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const b = $input.first().json.body || {};\nconst text = String(b.text || b.feedback || b.message || '').trim();\nif (!text) return [];\nreturn [{ json: { text: text.slice(0, 4000), email: String(b.email || '').trim(), source: b.source || 'form', user_id: b.user_id || '', plan: b.plan || '' } }];"
      },
      "id": "3efe0211-330f-5b24-bb34-354f772a3d10",
      "name": "Normalize",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        0
      ]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Source: {{ $json.source }} | Plan: {{ $json.plan || 'unknown' }}\nFeedback:\n{{ $json.text }}",
        "hasOutputParser": true,
        "messages": {
          "messageValues": [
            {
              "message": "=You triage customer feedback for a startup. Product areas: {{ $('Config').first().json.product_areas }}.\nseverity: 1 (cosmetic) to 5 (data loss, outage, payment failure). churn_risk when the customer threatens to leave, asks to cancel, or compares to a competitor negatively. suggested_reply: 2-4 sentences, human, no promises about dates."
            }
          ]
        }
      },
