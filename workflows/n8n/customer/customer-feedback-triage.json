      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"type\": {\n      \"type\": \"string\",\n      \"enum\": [\n        \"bug\",\n        \"feature_request\",\n        \"churn_risk\",\n        \"question\",\n        \"praise\",\n        \"other\"\n      ]\n    },\n    \"severity\": {\n      \"type\": \"number\"\n    },\n    \"product_area\": {\n      \"type\": \"string\"\n    },\n    \"summary\": {\n      \"type\": \"string\"\n    },\n    \"customer_quote\": {\n      \"type\": \"string\"\n    },\n    \"suggested_reply\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"type\",\n    \"severity\",\n    \"product_area\",\n    \"summary\",\n    \"customer_quote\",\n    \"suggested_reply\"\n  ],\n  \"additionalProperties\": false\n}"
      },
