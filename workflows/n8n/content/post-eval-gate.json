              "value": "https://docs.google.com/spreadsheets/d/REPLACE_WITH_SHEET_ID/edit",
              "type": "string"
            },
            {
              "id": "77b6304d-6ce6-52c6-af3c-203550157e8a",
              "name": "positioning",
              "value": "Founder building open-source AI developer tools",
              "type": "string"
            },
            {
              "id": "a4307826-08ac-5473-a973-911711f83010",
              "name": "audience",
              "value": "Developers and early-stage founders",
              "type": "string"
            }
          ]
        },
        "includeOtherFields": true,
        "options": {}
      },
      "id": "6ef965dc-59b7-5a16-85ee-02f5da78958d",
      "name": "Config",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        240,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const b = $input.first().json.body || {};\nconst draft = String(b.draft || b.text || '').trim();\nif (!draft) throw new Error('Send JSON with \"draft\" and \"platform\" (x or linkedin).');\nconst platform = String(b.platform || '').toLowerCase().includes('linked') ? 'linkedin' : (b.platform ? 'x' : '');\nif (!platform) throw new Error('platform is required: \"x\" or \"linkedin\". The post-eval skill asks before scoring when it is unclear.');\nconst limit = platform === 'x' ? 280 : 1500;\nconst hasLink = /https?:\\/\\/\\S+/.test(draft) || Boolean(b.proof_url);\nreturn [{ json: { draft, platform, limit, chars: draft.length, over_limit: draft.length > limit, has_link: hasLink,\n  proof_url: b.proof_url || '', author_goal: b.author_goal || '' } }];"
      },
      "id": "5c4f2de6-6c0c-587c-b69d-6663eaf85577",
      "name": "Prepare draft",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        0
      ]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Platform: {{ $json.platform }} (limit {{ $json.limit }} chars, draft is {{ $json.chars }})\nHas a link/artefact: {{ $json.has_link }} {{ $json.proof_url }}\nAuthor goal for this post: {{ $json.author_goal || 'not given' }}\n\nDRAFT:\n{{ $json.draft }}",
        "hasOutputParser": true,
        "messages": {
          "messageValues": [
            {
              "message": "=You are the post-eval skill from github.com/salikshah/startup-agent-skills (skills/00-post-eval).\nScore the draft for the author's goals. Integers only.\n1. strategic_alignment (0-20): advances the stated positioning, shows expertise rather than intent, clear CTA, right audience.\n2. proof_of_work (0-25): links to something concrete (repo, audit, case study), shows results, evidence the author can do it.\n3. content_quality (0-20): hook stops the scroll, value clear in two sentences, authentic tone (not corporate, not AI-sounding), concise.\n4. timing (0-15): reason to post now, rides a current conversation, audience is active.\n5. risk (0-20): 20 = no risk. Deduct for negative attention, leaking unlaunched work, promises the author can't keep, easy misreadings.\nGive 2-4 pros, 2-4 cons, the gaps, one specific recommendation and one improved rewrite in the author's voice.\n\nAuthor positioning: {{ $('Config').first().json.positioning }}\nTarget audience: {{ $('Config').first().json.audience }}"
            }
          ]
        }
      },
      "id": "9ba71438-9728-585d-a01e-ac14427e9f41",
      "name": "Score with post-eval rubric",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.7,
      "position": [
        720,
        0
      ]
    },
    {
      "parameters": {
        "model": {
          "__rl": true,
          "mode": "list",
          "value": "gpt-4o-mini",
          "cachedResultName": "gpt-4o-mini"
        },
        "options": {
          "temperature": 0.2
        }
      },
      "id": "c1db4abe-b524-5015-8a70-1e8c1e115c74",
      "name": "Score with post-eval rubric - model",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1.2,
      "position": [
        648,
        200
      ],
      "credentials": {
        "openAiApi": {
          "id": "REPLACE_WITH_YOUR_CREDENTIAL_ID",
          "name": "OpenAI (or OpenAI-compatible) account"
        }
      }
    },
    {
      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"strategic_alignment\": {\n      \"type\": \"number\"\n    },\n    \"proof_of_work\": {\n      \"type\": \"number\"\n    },\n    \"content_quality\": {\n      \"type\": \"number\"\n    },\n    \"timing\": {\n      \"type\": \"number\"\n    },\n    \"risk\": {\n      \"type\": \"number\"\n    },\n    \"pros\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"string\"\n      }\n    },\n    \"cons\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"string\"\n      }\n    },\n    \"gaps\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"string\"\n      }\n    },\n    \"recommendation\": {\n      \"type\": \"string\"\n    },\n    \"rewrite\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"strategic_alignment\",\n    \"proof_of_work\",\n    \"content_quality\",\n    \"timing\",\n    \"risk\",\n    \"pros\",\n    \"cons\",\n    \"gaps\",\n    \"recommendation\",\n    \"rewrite\"\n  ],\n  \"additionalProperties\": false\n}"
      },
      "id": "f76f54a2-f4bb-5f8d-8806-3f6fe43100b0",
      "name": "Score with post-eval rubric - JSON schema",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.3,
      "position": [
        840,
        200
      ]
    },
    {
      "parameters": {
        "jsCode": "// Apply the post-eval skill's hard rules on top of the model's scores.\nconst cfg = $('Config').first().json;\nconst p = $('Prepare draft').first().json;\nconst o = $input.first().json.output;\nconst clamp = (v, max) => Math.max(0, Math.min(max, Math.round(Number(v) || 0)));\nconst s = {\n  strategic_alignment: clamp(o.strategic_alignment, 20),\n  proof_of_work: clamp(o.proof_of_work, 25),\n  content_quality: clamp(o.content_quality, 20),\n  timing: clamp(o.timing, 15),\n  risk: clamp(o.risk, 20),\n};\nconst notes = [];\nif (!p.has_link && s.proof_of_work > 10) { s.proof_of_work = 10; notes.push('No link or artefact: proof of work capped at 10/25.'); }\nif (p.over_limit) notes.push(p.platform + ' draft is ' + p.chars + ' chars; limit ' + p.limit + '.');\nconst total = Object.values(s).reduce((a, b) => a + b, 0);\nconst verdict = total >= Number(cfg.threshold) && !p.over_limit ? 'POST' : \"DON'T POST\";\nreturn [{ json: { verdict, score: total, threshold: Number(cfg.threshold), scores: s, notes,\n  pros: o.pros, cons: o.cons, gaps: o.gaps, recommendation: o.recommendation, rewrite: o.rewrite,\n  draft: p.draft, platform: p.platform } }];"
      },
      "id": "939b2cc9-2de2-54ac-8d73-1e7fa340002f",
      "name": "Apply gates",
      "type": "n8n-nodes-base.code",
