        "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"company_summary\": {\n      \"type\": \"string\"\n    },\n    \"industry\": {\n      \"type\": \"string\"\n    },\n    \"company_size_guess\": {\n      \"type\": \"string\"\n    },\n    \"icp_fit\": {\n      \"type\": \"number\"\n    },\n    \"fit_reason\": {\n      \"type\": \"string\"\n    },\n    \"intent\": {\n      \"type\": \"string\",\n      \"enum\": [\n        \"high\",\n        \"medium\",\n        \"low\"\n      ]\n    },\n    \"next_step\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"company_summary\",\n    \"industry\",\n    \"company_size_guess\",\n    \"icp_fit\",\n    \"fit_reason\",\n    \"intent\",\n    \"next_step\"\n  ],\n  \"additionalProperties\": false\n}"
