      "id": "ec72cc56-35be-5c91-bb04-f2cab2f4f18d",
      "name": "Fetch homepage",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        960,
        -200
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "const lead = $('Normalize lead').first().json;\nconst html = String($input.first().json.data || '');\nconst text = html.replace(/<script[\\s\\S]*?<\\/script>/gi, ' ').replace(/<style[\\s\\S]*?<\\/style>/gi, ' ')\n  .replace(/<[^>]+>/g, ' ').replace(/\\s+/g, ' ').trim().slice(0, 6000);\nreturn [{ json: { ...lead, site_text: text } }];"
      },
      "id": "e17f266b-6524-503a-811d-c1d37d2ad9a5",
      "name": "Homepage to text",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1200,
        -200
      ]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Form: {{ JSON.stringify({ name: $json.name, email: $json.email, company: $json.company, website: $json.website, message: $json.message, free_email: $json.free_email }) }}\n\nHomepage text:\n{{ $json.site_text || 'not available' }}",
        "hasOutputParser": true,
        "messages": {
          "messageValues": [
            {
              "message": "=You qualify inbound B2B leads. ICP: {{ $('Config').first().json.icp }}\nUse only the form data and homepage text. If something is unknown, say \"unknown\"; never guess revenue or headcount as fact.\nicp_fit is 0-100."
            }
          ]
        }
      },
