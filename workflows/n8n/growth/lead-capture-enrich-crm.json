{
  "name": "Lead capture: enrich from website, score ICP fit, upsert to sheet CRM, alert Slack",
  "nodes": [
    {
      "parameters": {
        "content": "## Lead capture + enrichment (original)\nPOST form data (`email`, `name`, `company`, `website`, `message`). Drops bots (honeypot `company_website_confirm`) and invalid emails, reads the company homepage, scores fit against your ICP, upserts on `email` in a Google Sheet CRM, and pings Slack for strong fits.\nNo outbound email is sent.",
        "height": 240,
        "width": 500
      },
      "id": "0da077d0-8c04-5344-a40b-813b05f36841",
      "name": "Note 1",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -240,
        -400
      ]
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "lead",
        "options": {}
      },
      "id": "a26cd7a9-503d-5dfd-9c2d-a0119a70d19d",
      "name": "Lead webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "webhookId": "c7a6f26d-8be2-5a2e-9435-bf798eea60d7"
    },
    {
      "parameters": {
        "mode": "manual",
        "assignments": {
          "assignments": [
            {
              "id": "4cbeadf0-673d-56fd-955e-4e07eeacdedc",
              "name": "sheet_url",
              "value": "https://docs.google.com/spreadsheets/d/REPLACE_WITH_SHEET_ID/edit",
              "type": "string"
            },
            {
              "id": "c69cf90e-a2c3-54ea-af3f-9cc4bf5fb545",
              "name": "slack_channel_id",
              "value": "C0123456789",
              "type": "string"
            },
            {
              "id": "dc22eb7d-9433-5de2-9ebc-4c70ac8e44fe",
              "name": "fit_threshold",
              "value": 70,
              "type": "number"
            },
            {
              "id": "c5b28f73-8271-5f73-949b-a0023f18f3b3",
              "name": "icp",
              "value": "B2B SaaS, 5-200 employees, engineering-led, selling to developers",
              "type": "string"
            }
          ]
        },
        "includeOtherFields": true,
        "options": {}
      },
      "id": "2a2ef298-5454-584c-b32b-ab9f83506fc9",
      "name": "Config",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        240,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const FREE = ['gmail.com','googlemail.com','yahoo.com','hotmail.com','outlook.com','live.com','icloud.com','proton.me','protonmail.com','aol.com','gmx.de','web.de'];\nconst b = $input.first().json.body || {};\nif (b.company_website_confirm) return []; // honeypot field filled by bots\nconst email = String(b.email || '').trim().toLowerCase();\nif (!/^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$/.test(email)) return [];\nconst emailDomain = email.split('@')[1];\nlet site = String(b.website || '').trim();\nif (!site && !FREE.includes(emailDomain)) site = 'https://' + emailDomain;\nif (site && !/^https?:\\/\\//.test(site)) site = 'https://' + site;\nreturn [{ json: { email, name: String(b.name || '').trim(), company: String(b.company || '').trim(), website: site,\n  message: String(b.message || '').slice(0, 2000), source: b.source || 'website', free_email: FREE.includes(emailDomain) } }];"
      },
      "id": "f0229eac-b455-5ca2-81db-53df8e9f2a6e",
      "name": "Normalize lead",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "a2d242cf-4b93-5964-b17a-14cd511fa0a6",
              "leftValue": "={{ $json.website }}",
              "operator": {
                "type": "string",
                "operation": "notEmpty",
                "singleValue": true
              },
              "rightValue": ""
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "3f26ed61-3614-5a41-bb48-b8aafbdfbe22",
      "name": "Has a website?",
