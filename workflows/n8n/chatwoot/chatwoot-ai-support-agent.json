      "id": "f311210e-bfda-585e-997f-96ca2b8d1e91",
      "name": "Config",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        240,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "// Decide whether the AI should answer this Chatwoot event. Returns no items (stops) when it should not.\nconst cfg = $('Config').first().json;\nconst b = $input.first().json.body || {};\nconst conv = b.conversation || {};\nconst labels = conv.labels || [];\nconst skip = [];\nif (b.event !== 'message_created') skip.push('event is ' + b.event);\nif (b.message_type !== 'incoming') skip.push('not an incoming customer message');\nif (b.private) skip.push('private note');\nif (!b.content || !String(b.content).trim()) skip.push('empty message');\nif (labels.includes(cfg.handoff_label)) skip.push('already handed off to a human');\nif (cfg.only_when_pending && conv.status && conv.status !== 'pending') skip.push('conversation is ' + conv.status + ', a human owns it');\nif (skip.length) {\n  console.log('Skipping Chatwoot event: ' + skip.join('; '));\n  return [];\n}\nreturn [{ json: {\n  account_id: (b.account && b.account.id) || conv.account_id,\n  conversation_id: conv.id || (b.conversation && b.conversation.display_id),\n  inbox_id: b.inbox && b.inbox.id,\n  message: String(b.content).slice(0, 4000),\n  contact_name: (b.sender && b.sender.name) || '',\n  channel: conv.channel || ''\n} }];"
      },
      "id": "9c21ce8d-6749-5ae7-bbf2-b87df14f50a4",
      "name": "Should the bot answer?",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        0
      ]
    },
    {
