      "id": "9613b787-2bfd-59ec-9b4f-9a84ca5b94bb",
      "name": "Get knowledge base",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        960,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "// Turn Chatwoot history + knowledge base text into one prompt context.\nconst cfg = $('Config').first().json;\nconst raw = $('Get conversation history').first().json.payload || [];\nconst msgs = raw\n  .filter(m => m.content && !m.private && m.message_type !== 2 && m.message_type !== 'activity')\n  .slice(-Number(cfg.history_messages || 12));\nconst who = m => (m.message_type === 0 || m.message_type === 'incoming') ? 'Customer' : 'Support';\nconst history = msgs.map(m => who(m) + ': ' + String(m.content).replace(/\\s+/g, ' ').trim()).join('\\n');\nlet kb = $('Get knowledge base').first().json.data || '';\nif (typeof kb !== 'string') kb = JSON.stringify(kb);\nkb = kb.slice(0, Number(cfg.kb_max_chars || 12000));\nreturn [{ json: { history, kb, message: $('Should the bot answer?').first().json.message } }];"
      },
      "id": "dc885c62-0d66-5856-98c7-4232e20ae163",
      "name": "Build context",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1200,
        0
      ]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Conversation so far:\n{{ $json.history }}\n\nLatest customer message:\n{{ $json.message }}",
        "hasOutputParser": true,
        "messages": {
          "messageValues": [
            {
              "message": "=You are the first-line support assistant for {{ $('Config').first().json.company_name }}.\nAnswer ONLY from the KNOWLEDGE BASE below. Never invent prices, dates, policies, links or features.\nIf the knowledge base does not cover the question, set needs_human=true and confidence below 0.5.\nAlways set needs_human=true for: refunds, billing disputes, cancellations, legal or privacy requests, account access, threats, or a customer who is upset.\nKeep answers short, friendly and concrete. Match the customer's language. Do not mention that you are reading a knowledge base.\n\nKNOWLEDGE BASE\n---\n{{ $json.kb }}\n---"
            }
          ]
        }
      },
