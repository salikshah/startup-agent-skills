      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"answer\": {\n      \"type\": \"string\",\n      \"description\": \"Reply to send to the customer, in their language, under 120 words\"\n    },\n    \"confidence\": {\n      \"type\": \"number\",\n      \"description\": \"0 to 1. How sure you are the answer is fully supported by the knowledge base\"\n    },\n    \"needs_human\": {\n      \"type\": \"boolean\",\n      \"description\": \"true for refunds, billing disputes, legal, angry customers, account access, or anything not covered by the knowledge base\"\n    },\n    \"reason\": {\n      \"type\": \"string\",\n      \"description\": \"One sentence for the human agent explaining the decision\"\n    },\n    \"topic\": {\n      \"type\": \"string\",\n      \"description\": \"Short topic label, e.g. billing, onboarding, bug\"\n    }\n  },\n  \"required\": [\n    \"answer\",\n    \"confidence\",\n    \"needs_human\",\n    \"reason\",\n    \"topic\"\n  ],\n  \"additionalProperties\": false\n}"
      },
