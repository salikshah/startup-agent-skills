              "value": "REPLACE_WITH_YOUR_TELEGRAM_CHAT_ID",
              "type": "string"
            },
            {
              "id": "4cbeadf0-673d-56fd-955e-4e07eeacdedc",
              "name": "sheet_url",
              "value": "https://docs.google.com/spreadsheets/d/REPLACE_WITH_SHEET_ID/edit",
              "type": "string"
            },
            {
              "id": "b00af813-106a-5637-8fb3-db617b5cc196",
              "name": "timezone",
              "value": "Europe/London",
              "type": "string"
            }
          ]
        },
        "includeOtherFields": true,
        "options": {}
      },
      "id": "de684721-99be-5247-8d9b-9d8ee3c75107",
      "name": "Config",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        240,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "446db134-e851-522f-ba94-a8b0b3e329b7",
              "leftValue": "={{ String($json.message.chat.id) }}",
              "operator": {
                "type": "string",
                "operation": "equals"
              },
              "rightValue": "={{ $json.allowed_chat_id }}"
            },
            {
              "id": "1fd6b524-25f7-5a55-ba8c-cbb6e54fc933",
              "leftValue": "={{ $json.message.voice?.file_id || $json.message.audio?.file_id || '' }}",
              "operator": {
                "type": "string",
                "operation": "notEmpty",
                "singleValue": true
              },
              "rightValue": ""
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "1c97847b-6e68-58ff-a3f1-7bf974d045ba",
      "name": "Voice note from me?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        480,
        0
      ]
    },
    {
      "parameters": {
        "resource": "file",
        "fileId": "={{ $json.message.voice?.file_id || $json.message.audio?.file_id }}",
        "download": true,
        "additionalFields": {}
      },
      "id": "53df9b29-e4b5-5396-ae26-664253bdc86b",
      "name": "Download audio",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        720,
        0
      ],
      "credentials": {
        "telegramApi": {
          "id": "REPLACE_WITH_YOUR_CREDENTIAL_ID",
          "name": "Telegram bot"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.elevenlabs.io/v1/speech-to-text",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "contentType": "multipart-form-data",
        "bodyParameters": {
          "parameters": [
            {
              "parameterType": "formBinaryData",
              "name": "file",
              "inputDataFieldName": "data"
            },
            {
              "name": "model_id",
              "value": "scribe_v1"
            }
          ]
        },
        "options": {
          "timeout": 120000
        }
      },
      "id": "1dcdacb5-bbb6-5188-825c-8cd7b1f8cc02",
      "name": "ElevenLabs speech to text",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        960,
        0
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "REPLACE_WITH_YOUR_CREDENTIAL_ID",
          "name": "Header Auth (set in n8n)"
        }
      }
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Transcript:\n{{ $json.text }}",
        "hasOutputParser": true,
        "messages": {
          "messageValues": [
            {
              "message": "=You turn a founder's spoken notes into concrete tasks. Today is {{ $now.setZone($('Config').first().json.timezone).toISODate() }}. Resolve relative dates (\"tomorrow\", \"Friday\") to YYYY-MM-DD, else use an empty string. Priority 1 (urgent) to 4 (someday). Ignore filler. Do not invent tasks."
            }
          ]
        }
      },
      "id": "a2baa982-bb8e-5c58-bf7f-bae4a875bced",
      "name": "Extract tasks",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.7,
      "position": [
        1200,
        0
      ]
    },
    {
      "parameters": {
        "model": {
          "__rl": true,
          "mode": "list",
          "value": "gpt-4o-mini",
          "cachedResultName": "gpt-4o-mini"
        },
        "options": {
          "temperature": 0.2
        }
      },
      "id": "a0c9aff8-4da2-5cc3-a15c-3b66d937bccc",
      "name": "Extract tasks - model",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1.2,
      "position": [
        1128,
        200
      ],
      "credentials": {
        "openAiApi": {
          "id": "REPLACE_WITH_YOUR_CREDENTIAL_ID",
          "name": "OpenAI (or OpenAI-compatible) account"
        }
      }
    },
    {
      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"tasks\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"title\": {\n            \"type\": \"string\"\n          },\n          \"due_date\": {\n            \"type\": \"string\"\n          },\n          \"priority\": {\n            \"type\": \"number\"\n          },\n          \"context\": {\n            \"type\": \"string\"\n          }\n        },\n        \"required\": [\n          \"title\",\n          \"due_date\",\n          \"priority\",\n          \"context\"\n        ],\n        \"additionalProperties\": false\n      }\n    },\n    \"summary\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"tasks\",\n    \"summary\"\n  ],\n  \"additionalProperties\": false\n}"
      },
      "id": "0a435158-dba7-56eb-9ce9-a827f875625e",
      "name": "Extract tasks - JSON schema",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.3,
      "position": [
        1320,
        200
      ]
    },
    {
      "parameters": {
        "jsCode": "const out = $input.first().json.output || {};\nconst chat = $('Telegram trigger').first().json.message.chat.id;\nreturn (out.tasks || []).map(t => ({ json: { ...t, source: 'voice', chat_id: chat, created_at: new Date().toISOString(), transcript: $('ElevenLabs speech to text').first().json.text } }));"
      },
      "id": "0a34e499-4a25-503a-97ea-61088b58d6cd",
      "name": "One row per task",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
