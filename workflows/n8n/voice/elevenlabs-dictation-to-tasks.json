{
  "name": "ElevenLabs: Telegram voice note to tasks",
  "nodes": [
    {
      "parameters": {
        "content": "## Dictation -> tasks (original)\nSend a voice note to your Telegram bot. ElevenLabs Scribe transcribes it, an LLM pulls out tasks (title, due date, priority), they are appended to a Google Sheet and the bot replies with what it captured.\nOnly the chat id in **Config** is served.",
        "height": 240,
        "width": 480
      },
      "id": "99342909-ead0-5104-af02-f62f28609760",
      "name": "Note 1",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -240,
        -400
      ]
    },
    {
      "parameters": {
        "updates": [
          "message"
        ],
        "additionalFields": {}
      },
      "id": "b8620263-f729-592d-aaa2-1f52fa9da1b0",
      "name": "Telegram trigger",
