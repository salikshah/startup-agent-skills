{
  "name": "ElevenLabs voice agent: n8n server tools (FAQ lookup + lead capture)",
  "nodes": [
    {
      "parameters": {
        "content": "## Voice agent tools (original)\nOne webhook serves ElevenLabs Agent *server tools*. Route with `?tool=lookup_faq` or `?tool=capture_lead` in the tool URL.\nEvery request must carry header `x-tool-secret` equal to `shared_secret` in **Config**.\nResponses are short JSON the agent reads aloud.",
        "height": 240,
        "width": 480
      },
      "id": "8e51afcf-b5f6-5bc8-8d16-d6750959c449",
      "name": "Note 1",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -240,
        -400
      ]
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "elevenlabs-tools",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "dc044def-90ee-5c97-8b3a-61501c542303",
      "name": "Tool webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "webhookId": "3224b39b-a53b-5a8b-a990-1c776ca63292"
    },
    {
      "parameters": {
        "mode": "manual",
        "assignments": {
