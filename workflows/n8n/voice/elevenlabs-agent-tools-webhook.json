              "value": "https://raw.githubusercontent.com/your-org/your-repo/main/support/faq.md",
              "type": "string"
            },
            {
              "id": "4cbeadf0-673d-56fd-955e-4e07eeacdedc",
              "name": "sheet_url",
              "value": "https://docs.google.com/spreadsheets/d/REPLACE_WITH_SHEET_ID/edit",
              "type": "string"
            },
            {
              "id": "5a622b42-21ab-5985-a184-0ea3dab7347c",
              "name": "company_name",
              "value": "Acme",
              "type": "string"
            }
          ]
        },
        "includeOtherFields": true,
        "options": {}
      },
      "id": "56a69754-d2fb-5c5f-9e12-a2119c49bf7c",
      "name": "Config",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        240,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "// Shared-secret check + tool routing for ElevenLabs Agent server tools.\nconst cfg = $('Config').first().json;\nconst req = $input.first().json;\nconst h = req.headers || {};\nconst secret = h['x-tool-secret'] || '';\nconst ok = cfg.shared_secret && !String(cfg.shared_secret).startsWith('REPLACE') && secret === cfg.shared_secret;\nconst body = req.body || {};\nconst tool = ok ? String(body.tool || (req.query || {}).tool || '') : 'unauthorized';\nreturn [{ json: { tool, args: body, conversation_id: body.conversation_id || '' } }];"
      },
      "id": "ef07452a-1ced-5712-a8ed-cd11e765b6f1",
      "name": "Check secret and route",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        0
      ]
    },
    {
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "loose",
                  "version": 2
                },
                "conditions": [
                  {
                    "id": "eb91ed67-a1c5-5dbe-96b8-714dce0eab4c",
                    "leftValue": "={{ $json.tool }}",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    },
                    "rightValue": "lookup_faq"
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "lookup_faq"
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "loose",
                  "version": 2
                },
                "conditions": [
                  {
                    "id": "26137b81-bc6d-575b-a047-e7489a43f4d8",
                    "leftValue": "={{ $json.tool }}",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    },
                    "rightValue": "capture_lead"
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "capture_lead"
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "loose",
                  "version": 2
                },
                "conditions": [
                  {
                    "id": "107ced54-8746-5f44-b8c0-d11cde83a45d",
                    "leftValue": "={{ $json.tool }}",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    },
                    "rightValue": "unauthorized"
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "unauthorized"
            }
          ]
        },
        "options": {
          "fallbackOutput": "extra"
        }
      },
      "id": "4151fc6d-c22b-5b50-96d8-9d1f7fa6867e",
      "name": "Which tool?",
