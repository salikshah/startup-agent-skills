    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Caller question: {{ $('Check secret and route').first().json.args.question }}",
        "hasOutputParser": true,
        "messages": {
          "messageValues": [
            {
              "message": "=You answer phone questions for {{ $('Config').first().json.company_name }} using ONLY the knowledge base. Reply in at most two short spoken sentences, no lists, no URLs. If the answer is not in the knowledge base, set found=false and say you will have a person follow up.\n\nKNOWLEDGE BASE\n---\n{{ $json.data.slice(0, 12000) }}\n---"
            }
          ]
        }
      },
