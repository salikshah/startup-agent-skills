    {
      "parameters": {
        "jsCode": "// Verify the ElevenLabs post-call webhook HMAC (header: elevenlabs-signature: t=<ts>,v0=<hex>).\n// Needs NODE_FUNCTION_ALLOW_BUILTIN=crypto on the n8n container.\nconst crypto = require('crypto');\nconst cfg = $('Config').first().json;\nconst item = $('Post-call webhook').first();\nconst headers = item.json.headers || {};\nlet raw = '';\ntry { raw = (await this.helpers.getBinaryDataBuffer(0, 'data')).toString('utf8'); } catch (e) { raw = JSON.stringify(item.json.body || {}); }\nlet body = item.json.body;\nif (!body || !Object.keys(body).length) body = JSON.parse(raw || '{}');\nlet valid = false, reason = '';\nif (!cfg.webhook_secret || String(cfg.webhook_secret).startsWith('REPLACE')) {\n  valid = cfg.allow_unsigned === true; reason = 'webhook_secret not set';\n} else {\n  const parts = Object.fromEntries(String(headers['elevenlabs-signature'] || '').split(',').map(p => p.split('=')));\n  const expected = crypto.createHmac('sha256', cfg.webhook_secret).update(parts.t + '.' + raw).digest('hex');\n  const fresh = Math.abs(Date.now() / 1000 - Number(parts.t)) < 1800;\n  valid = Boolean(parts.v0) && parts.v0 === expected && fresh;\n  reason = valid ? 'ok' : 'bad or stale signature';\n}\nconst d = body.data || {};\nconst a = d.analysis || {};\nconst dc = a.data_collection_results || {};\nconst val = k => (dc[k] && dc[k].value) || '';\nconst transcript = (d.transcript || []).map(t => t.role + ': ' + (t.message || '')).join('\\n');\nreturn [{ json: { valid, reason, type: body.type, conversation_id: d.conversation_id, agent_id: d.agent_id,\n  duration_secs: (d.metadata || {}).call_duration_secs, call_successful: a.call_successful, summary: a.transcript_summary || '',\n  caller_name: val('name'), caller_email: val('email'), follow_up: val('follow_up'), transcript: transcript.slice(0, 12000) } }];"
      },
