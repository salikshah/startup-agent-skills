              "value": 4500,
              "type": "number"
            }
          ]
        },
        "includeOtherFields": true,
        "options": {}
      },
      "id": "43fe81a1-641c-5094-9af9-4004a8d4b4c3",
      "name": "Config",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        240,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "// Make social-post text speakable: drop URLs, hashtags, emoji, markdown.\nconst cfg = $('Config').first().json;\nconst b = $input.first().json.body || {};\nlet t = String(b.text || '').trim();\nif (!t) throw new Error('Send JSON with a \"text\" field.');\nt = t.replace(/https?:\\/\\/\\S+/g, '')\n     .replace(/#(\\w+)/g, '$1')\n     .replace(/[*_`>#]+/g, '')\n     .replace(/[\\u{1F300}-\\u{1FAFF}\\u{2600}-\\u{27BF}]/gu, '')\n     .replace(/\\n{2,}/g, '\\n\\n').replace(/[ \\t]+/g, ' ').trim();\nconst max = Number(cfg.max_chars || 4500);\nif (t.length > max) throw new Error('Text is ' + t.length + ' characters; limit is ' + max + '. Split it first.');\nreturn [{ json: { script: t, voice_id: b.voice_id || cfg.voice_id, title: b.title || 'voiceover' } }];"
      },
      "id": "8246856f-c2b9-5436-b983-58ce1ff35fff",
      "name": "Make it speakable",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://api.elevenlabs.io/v1/text-to-speech/{{ $json.voice_id }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "output_format",
              "value": "={{ $('Config').first().json.output_format }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ text: $json.script, model_id: $('Config').first().json.model_id, voice_settings: { stability: 0.5, similarity_boost: 0.75 } }) }}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "file"
            }
          },
          "timeout": 120000
        }
      },
      "id": "0cdc2daf-94d6-51df-9d7c-c1aa85851d6d",
      "name": "ElevenLabs text to speech",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        720,
